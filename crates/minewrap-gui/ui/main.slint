// Minewrap P1 — Slint GUI main window (chunk 1).
// Ported from the measured C1 spike:
// dark token palette, Noto Sans 10pt, 1000-line console ListView with
// line-granularity selection + arboard copy, auto-scroll stick.
import { LineEdit, ListView } from "std-widgets.slint";

export struct LogLine {
    seq: int,
    ts: string,
    tag: string,
    level: int, // 0 INFO, 1 WARN, 2 ERROR, 3 DEBUG
    msg: string,
}

export struct InstRow {
    id: string,
    name: string,
    state: string, // combined_state label
    code: int,     // 0 online, 1 starting, 2 stopping, 3 offline,
                   // 4 crashed, 5 unresponsive, 6 unknown
}

global Tok {
    out property <color> bg: #0f172a;
    out property <color> fg: #f8fafc;
    out property <color> card: #1b2336;
    out property <color> muted: #272f42;
    out property <color> muted-fg: #94a3b8;
    out property <color> border: #475569;
    out property <color> accent: #22c55e;
    out property <color> err: #ef4444;
    out property <color> warn: #f59e0b;
    out property <color> debug: #38bdf8;
    out property <color> online: #22c55e;
    out property <color> offline: #64748b;
    out property <color> crashed: #ef4444;
    out property <color> selection: #334155;
}

component TokBtn inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 26px;
    width: max(72px, lbl.preferred-width + 20px);
    border-radius: 6px;
    border-width: 1px;
    border-color: !root.enabled ? Tok.muted : (root.active ? Tok.accent : Tok.border);
    background: (!root.enabled || !ta.has-hover) ? Tok.card : Tok.muted;
    ta := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
    lbl := Text {
        text: root.label;
        color: !root.enabled ? Tok.muted-fg : (root.active ? Tok.accent : Tok.fg);
        font-size: 10pt;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component InstanceRow inherits Rectangle {
    in property <string> id: "";
    in property <string> name: "";
    in property <string> state: "";
    in property <int> code: 3;
    in property <bool> selected: false;
    callback picked;
    height: 44px;
    border-radius: 6px;
    background: root.selected ? Tok.muted : (ta.has-hover ? #1f2940 : transparent);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Rectangle {
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.code == 0 ? Tok.online
                : root.code == 1 || root.code == 2 ? Tok.warn
                : root.code == 4 || root.code == 5 ? Tok.crashed
                : Tok.offline;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                color: Tok.fg;
                font-size: 10pt;
                overflow: elide;
            }
            Text {
                text: root.id + " · " + root.state;
                color: Tok.muted-fg;
                font-size: 8pt;
                overflow: elide;
            }
        }
    }
    ta := TouchArea { clicked => { root.picked(); } }
}

export component App inherits Window {
    width: 1280px;
    height: 800px;
    title: "Minewrap";
    background: Tok.bg;
    default-font-family: "Noto Sans";
    default-font-size: 10pt;

    in-out property <[InstRow]> instances;
    in-out property <[LogLine]> lines;
    in-out property <string> selected-id: "";
    in-out property <string> instance-name: "";
    in-out property <string> instance-state: "—";
    in-out property <int> instance-code: 6;
    in-out property <bool> stick: true;
    in-out property <int> sel-lo: -1;
    in-out property <int> sel-hi: -1;
    in-out property <bool> daemon-ok: false;
    in-out property <string> daemon-info: "connecting…";
    in-out property <bool> ws-live: false;
    in-out property <string> status: "";
    in-out property <string> cmd-text: "";

    callback pick(int);
    callback step(int);
    callback control(string);
    callback send-command(string);
    callback copy-selection(int, int);
    callback add-instance();

    pure function level-color(level: int) -> color {
        return level == 1 ? Tok.warn : level == 2 ? Tok.err : level == 3 ? Tok.debug : Tok.fg;
    }
    pure function state-color(code: int) -> color {
        return code == 0 ? Tok.online
            : code == 1 || code == 2 ? Tok.warn
            : code == 4 || code == 5 ? Tok.crashed
            : Tok.offline;
    }
    pure function can-start(code: int) -> bool {
        return code == 3 || code == 4 || code == 6;
    }
    pure function can-stop(code: int) -> bool {
        return code == 0 || code == 1 || code == 2 || code == 5;
    }
    pure function row-at(y: length) -> int {
        return root.lines.length == 0 ? -1
            : clamp(floor((y - lv.content-y) / 1px / 22), 0, root.lines.length - 1);
    }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "c") {
                if (root.sel-lo >= 0 && root.sel-hi >= 0) {
                    root.copy-selection(min(root.sel-lo, root.sel-hi), max(root.sel-lo, root.sel-hi));
                    return accept;
                }
            }
            if (event.text == Key.DownArrow) {
                root.step(1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.step(-1);
                return accept;
            }
            if (event.text == Key.PageUp) {
                lv.content-y = clamp(lv.content-y + lv.visible-height, min(0px, lv.visible-height - lv.content-height), 0px);
                root.stick = lv.content-y <= lv.visible-height - lv.content-height + 2px;
                return accept;
            }
            if (event.text == Key.PageDown) {
                lv.content-y = clamp(lv.content-y - lv.visible-height, min(0px, lv.visible-height - lv.content-height), 0px);
                root.stick = lv.content-y <= lv.visible-height - lv.content-height + 2px;
                return accept;
            }
            if (event.text == Key.End) {
                root.stick = true;
                return accept;
            }
            if (event.modifiers.control && event.text == "l") {
                cmd-input.focus();
                return accept;
            }
            if (event.text == Key.Escape) {
                fs.focus();
                return accept;
            }
            if (event.modifiers.control && event.text == "a") {
                root.sel-lo = 0;
                root.sel-hi = root.lines.length - 1;
                return accept;
            }
            reject
        }

        VerticalLayout {
            spacing: 0px;
            HorizontalLayout {
                spacing: 0px;
                // ---- sidebar: instances ----
                Rectangle {
                    width: 240px;
                    background: Tok.card;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;
                        Text {
                            text: "INSTANCES";
                            color: Tok.muted-fg;
                            font-size: 8pt;
                            height: 22px;
                        }
                        for inst[j] in root.instances: InstanceRow {
                            id: inst.id;
                            name: inst.name;
                            state: inst.state;
                            code: inst.code;
                            selected: root.selected-id == inst.id;
                            picked => { root.pick(j); }
                        }
                        Rectangle { vertical-stretch: 1; }
                        TokBtn {
                            label: "+ Add instance";
                            clicked => { root.add-instance(); }
                        }
                        Rectangle { height: 1px; background: Tok.border; }
                        HorizontalLayout {
                            spacing: 6px;
                            height: 22px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.daemon-ok ? Tok.online : Tok.crashed;
                            }
                            Text {
                                text: root.daemon-ok ? "daemon connected" : "daemon offline";
                                color: Tok.muted-fg;
                                font-size: 9pt;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                // ---- main column ----
                VerticalLayout {
                    spacing: 8px;
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 8px;
                    // top bar: selected instance + controls
                    HorizontalLayout {
                        height: 40px;
                        spacing: 8px;
                        Rectangle { width: 2px; }
                        VerticalLayout {
                            spacing: 0px;
                            alignment: center;
                            Text {
                                text: root.instance-name == "" ? "No instance selected" : root.instance-name;
                                color: Tok.fg;
                                font-size: 12pt;
                                overflow: elide;
                            }
                            Text {
                                text: root.instance-name == "" ? "" : root.instance-state;
                                color: root.state-color(root.instance-code);
                                font-size: 8pt;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TokBtn {
                            label: "Start";
                            active: true;
                            enabled: root.instance-name != "" && root.can-start(root.instance-code);
                            clicked => { root.control("start"); }
                        }
                        TokBtn {
                            label: "Stop";
                            enabled: root.instance-name != "" && root.can-stop(root.instance-code);
                            clicked => { root.control("stop"); }
                        }
                    }
                    // console header
                    HorizontalLayout {
                        height: 24px;
                        spacing: 8px;
                        Rectangle { width: 2px; }
                        Text {
                            text: "Console";
                            color: Tok.fg;
                            font-size: 11pt;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.ws-live ? "live" : "reconnecting…";
                            color: root.ws-live ? Tok.accent : Tok.warn;
                            font-size: 9pt;
                            vertical-alignment: center;
                        }
                    }
                    // console body
                    Rectangle {
                        vertical-stretch: 1;
                        background: Tok.bg;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Tok.border;
                        clip: true;

                        lv := ListView {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            for line[i] in root.lines: Rectangle {
                                height: 22px;
                                width: 100%;
                                background: (root.sel-hi >= 0 && i >= min(root.sel-lo, root.sel-hi) && i <= max(root.sel-lo, root.sel-hi)) ? Tok.selection : transparent;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    Text {
                                        text: line.ts;
                                        color: Tok.muted-fg;
                                        font-size: 10pt;
                                        width: 72px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "[" + line.tag + "]";
                                        color: root.level-color(line.level);
                                        font-size: 10pt;
                                        width: 62px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: line.msg;
                                        color: root.level-color(line.level);
                                        font-size: 10pt;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                            scrolled => {
                                root.stick = lv.content-y <= lv.visible-height - lv.content-height + 2px;
                            }
                        }

                        // selection overlay (leaves 14px for the scrollbar); captures wheel too
                        TouchArea {
                            x: 0;
                            y: 0;
                            width: parent.width - 14px;
                            height: parent.height;
                            scroll-event(e) => {
                                lv.content-y = clamp(lv.content-y + e.delta-y, min(0px, lv.visible-height - lv.content-height), 0px);
                                root.stick = lv.content-y <= lv.visible-height - lv.content-height + 2px;
                                accept
                            }
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    fs.focus();
                                    root.sel-lo = root.row-at(self.mouse-y);
                                    root.sel-hi = root.sel-lo;
                                }
                            }
                            moved => {
                                if (self.pressed) {
                                    root.sel-hi = root.row-at(self.mouse-y);
                                }
                            }
                        }
                        TokBtn {
                            x: parent.width - self.width - 22px;
                            y: parent.height - self.height - 10px;
                            label: "Jump to latest";
                            active: true;
                            visible: !root.stick;
                            clicked => { root.stick = true; }
                        }
                    }
                    // command input
                    Rectangle {
                        height: 40px;
                        background: Tok.card;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding: 6px;
                            spacing: 8px;
                            cmd-input := LineEdit {
                                text <=> root.cmd-text;
                                placeholder-text: "server command (stdin)";
                                font-family: "Noto Sans";
                                font-size: 10pt;
                                accepted => {
                                    root.send-command(root.cmd-text);
                                    root.cmd-text = "";
                                }
                            }
                            TokBtn {
                                label: "Send";
                                width: 72px;
                                enabled: root.cmd-text != "" && root.instance-name != "";
                                clicked => {
                                    root.send-command(root.cmd-text);
                                    root.cmd-text = "";
                                }
                            }
                        }
                    }
                }
            }
            // ---- status bar ----
            Rectangle {
                height: 26px;
                background: Tok.card;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 18px;
                    spacing: 12px;
                    Rectangle {
                        width: 8px; height: 8px; border-radius: 4px;
                        background: root.daemon-ok ? Tok.online : Tok.crashed;
                    }
                    Text {
                        text: root.daemon-info;
                        color: Tok.muted-fg;
                        font-size: 9pt;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 1px; height: 14px; background: Tok.border; }
                    Text {
                        text: root.ws-live ? "console: connected" : "console: reconnecting";
                        color: root.ws-live ? Tok.muted-fg : Tok.warn;
                        font-size: 9pt;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.status;
                        color: Tok.muted-fg;
                        font-size: 9pt;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: "ring " + root.lines.length + "/1000";
                        color: Tok.muted-fg;
                        font-size: 9pt;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    Timer {
        interval: 50ms;
        running: true;
        triggered => {
            if (root.stick && lv.content-height > lv.visible-height) {
                lv.content-y = lv.visible-height - lv.content-height;
            }
        }
    }
    // `init` runs before the Wayland surface is mapped; without this
    // deferred focus the window receives keys but no element owns focus,
    // so Ctrl+C/Ctrl+L would be dead until the first mouse click.
    focus-timer := Timer {
        interval: 300ms;
        running: true;
        triggered => {
            fs.focus();
            self.running = false;
        }
    }
    init => {
        fs.focus();
    }
}
