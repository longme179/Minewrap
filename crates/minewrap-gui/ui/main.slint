// Minewrap P1 — Slint GUI main window (chunk 1 + chunk 2).
// Chunk 1: daemon discovery/auto-spawn, 2 s instance-list polling,
// console WebSocket with `since_seq` backfill, 1000-line ring with
// per-level colours and Ctrl+C copy, Start/Stop + stdin command input.
// Chunk 2: add-instance wizard dialog, per-instance Settings panel
// (Instance / Probe / Restart, dirty tracking, discard confirmation),
// Remove instance with confirmation.
// SPDX-License-Identifier: AGPL-3.0-only

import { ComboBox, CheckBox, LineEdit, ListView, ScrollView, TextEdit } from "std-widgets.slint";

export struct LogLine {
    seq: int,
    ts: string,
    tag: string,
    level: int, // 0 INFO, 1 WARN, 2 ERROR, 3 DEBUG
    msg: string,
}

export struct InstRow {
    id: string,
    name: string,
    state: string, // combined_state label
    code: int,     // 0 online, 1 starting, 2 stopping, 3 offline,
                   // 4 crashed, 5 unresponsive, 6 unknown
}

export struct NodeRow {
    id: string,
    name: string,
    url: string,
    is_local: bool,
    state: string, // connection label (online / connecting / offline / …)
    code: int,     // dot color code, same scale as InstRow.code
    instances: [InstRow],
}

export struct ModRow {
    name: string,
    size: string,
    enabled: bool,
}

export global Theme {
    // --- colors (values unchanged from the previous hard-coded literals) ---
    out property <color> bg: #0f172a;
    out property <color> fg: #f8fafc;
    out property <color> card: #1b2336;
    out property <color> card-hover: #1f2940;
    out property <color> muted: #272f42;
    out property <color> muted-fg: #94a3b8;
    out property <color> border: #475569;
    out property <color> accent: #22c55e;
    out property <color> accent-text: #ffffff;
    out property <color> err: #ef4444;
    out property <color> warn: #f59e0b;
    out property <color> debug: #38bdf8;
    out property <color> online: #22c55e;
    out property <color> offline: #64748b;
    out property <color> crashed: #ef4444;
    out property <color> selection: #334155;
    out property <color> backdrop: #000000aa;

    // --- spacing / sizing ---
    out property <length> hairline: 1px;
    out property <length> divider: 2px;
    out property <length> vsep: 14px;
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 8px;
    out property <length> space-6: 6px;
    out property <length> space-8: 8px;
    out property <length> space-10: 10px;
    out property <length> space-12: 12px;
    out property <length> space-16: 16px;
    out property <length> space-18: 18px;
    out property <length> space-20: 20px;
    out property <length> space-24: 24px;
    out property <length> h-24: 24px;
    out property <length> h-26: 26px;
    out property <length> h-28: 28px;
    out property <length> h-32: 32px;
    out property <length> h-40: 40px;
    out property <length> h-44: 44px;
    out property <length> h-90: 90px;
    out property <length> h-100: 100px;
    out property <length> overlay-y: 92px;
    out property <length> line-h: 22px;
    out property <length> w-62: 62px;
    out property <length> w-72: 72px;
    out property <length> w-88: 88px;
    out property <length> w-120: 120px;
    out property <length> w-210: 210px;
    out property <length> w-220: 220px;
    out property <length> w-240: 240px;
    out property <length> w-420: 420px;
    out property <length> h-200: 200px;
    out property <length> win-w: 1280px;
    out property <length> win-h: 800px;
    out property <length> topbar-h: 40px;
    out property <length> tabs-h: 28px;
    out property <length> wiz-min-w: 720px;
    out property <length> wiz-min-h: 660px;

    // --- font sizes ---
    out property <length> text-xs: 8pt;
    out property <length> text-sm: 9pt;
    out property <length> text-base: 10pt;
    out property <length> text-lg: 11pt;
    out property <length> text-xl: 12pt;
    out property <length> text-wizard: 13pt;
}

component TokBtn inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked;
    height: Theme.h-26;
    width: max(Theme.w-72, lbl.preferred-width + Theme.space-20);
    border-radius: Theme.space-6;
    border-width: Theme.hairline;
    border-color: !root.enabled ? Theme.muted
        : (root.danger ? Theme.err : (root.active ? Theme.accent : Theme.border));
    background: (!root.enabled || !ta.has-hover) ? Theme.card : Theme.muted;
    ta := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
    lbl := Text {
        text: root.label;
        color: !root.enabled ? Theme.muted-fg : (root.active ? Theme.accent : (root.danger ? Theme.err : Theme.fg));
        font-size: Theme.text-base;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component InstanceRow inherits Rectangle {
    in property <string> id: "";
    in property <string> name: "";
    in property <string> state: "";
    in property <int> code: 3;
    in property <bool> selected: false;
    callback picked;
    height: Theme.h-44;
    border-radius: Theme.space-6;
    background: root.selected ? Theme.muted : (ta.has-hover ? Theme.card-hover : transparent);
    HorizontalLayout {
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        spacing: Theme.space-8;
        Rectangle {
            width: Theme.space-8;
            height: Theme.space-8;
            border-radius: Theme.radius-xs;
            background: root.code == 0 ? Theme.online
                : root.code == 1 || root.code == 2 ? Theme.warn
                : root.code == 4 || root.code == 5 ? Theme.crashed
                : Theme.offline;
        }
        VerticalLayout {
            alignment: center;
            spacing: Theme.hairline;
            horizontal-stretch: 1;
            Text {
                text: root.name;
                color: Theme.fg;
                font-size: Theme.text-base;
                overflow: elide;
            }
            Text {
                text: root.id + " · " + root.state;
                color: Theme.muted-fg;
                font-size: Theme.text-xs;
                overflow: elide;
            }
        }
    }
    ta := TouchArea { clicked => { root.picked(); } }
}

component ErrorText inherits Text {
    in property <string> content: "";
    text: root.content;
    color: Theme.err;
    font-size: Theme.text-sm;
    overflow: elide;
}

component Btn2 inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    height: Theme.h-32;
    width: max(Theme.w-88, txt.preferred-width + Theme.space-24);
    border-radius: Theme.space-6;
    border-width: Theme.hairline;
    border-color: !root.enabled ? Theme.border : (root.primary ? Theme.accent : Theme.border);
    background: (!root.enabled || root.primary) ? Theme.card-hover : Theme.card;
    ta := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
    txt := Text {
        text: root.label;
        color: !root.enabled ? Theme.muted-fg : (root.primary ? Theme.accent-text : Theme.fg);
        font-size: Theme.text-base;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component App inherits Window {
    width: Theme.win-w;
    height: 800px;
    title: "Minewrap";
    background: Theme.bg;
    default-font-family: "Noto Sans";
    default-font-size: Theme.text-base;

    in-out property <[InstRow]> instances;
    in-out property <[NodeRow]> nodes: [];
    in-out property <[LogLine]> lines;
    in-out property <string> selected-id: "";
    in-out property <string> selected-node: "";
    in-out property <string> instance-name: "";
    in-out property <string> instance-state: "—";
    in-out property <int> instance-code: 6;
    in-out property <bool> stick: true;
    in-out property <int> sel-lo: -1;
    in-out property <int> sel-hi: -1;
    in-out property <bool> daemon-ok: false;
    in-out property <string> daemon-info: "connecting…";
    in-out property <bool> ws-live: false;
    in-out property <string> status: "";
    in-out property <string> cmd-text: "";

    // --- navigation ---
    in-out property <int> settings-tab: 0; // 0 console, 1 settings, 2 properties, 3 mods, 4 notifications

    // --- Settings panel (bound two-way by the form widgets) ---
    in-out property <string> settings-name: "";
    in-out property <string> settings-work-dir: "";
    in-out property <string> settings-java: "java";
    in-out property <string> settings-min-ram: "2048";
    in-out property <string> settings-max-ram: "4096";
    in-out property <string> settings-preset: "none";
    in-out property <string> settings-jvm-extra: "";
    in-out property <string> settings-launch-mode: "jar";
    in-out property <string> settings-launch-args: "";
    in-out property <bool> settings-autostart: false;
    in-out property <string> settings-probe-host: "127.0.0.1";
    in-out property <string> settings-probe-port: "25565";
    in-out property <bool> settings-probe-query: false;
    in-out property <string> settings-probe-timeout: "3";
    in-out property <string> settings-restart-policy: "on-crash";
    in-out property <string> settings-restart-max-retries: "5";
    in-out property <string> settings-restart-backoff-base: "5";
    in-out property <string> settings-restart-backoff-max: "300";
    in-out property <string> settings-restart-reset-after: "600";
    in-out property <[string]> settings-java-items: ["java"];
    in-out property <string> settings-java-custom: "";
    in-out property <string> settings-error: "";
    in-out property <string> settings-status: "";
    in-out property <string> settings-scan-note: "";
    in-out property <string> settings-scan-error: "";
    in-out property <bool> settings-dirty: false;
    in-out property <bool> settings-loading: false;

    // --- Properties panel (raw server.properties editor) ---
    in-out property <string> properties-text: "";
    in-out property <string> properties-error: "";
    in-out property <string> properties-status: "";
    in-out property <bool> properties-dirty: false;
    in-out property <bool> properties-loading: false;

    // --- Mods panel ---
    in-out property <[ModRow]> mods: [];
    in-out property <[ModRow]> mods-filtered: [];
    in-out property <string> mods-filter: "";
    in-out property <string> mods-busy: "";
    in-out property <string> mods-status: "";
    in-out property <string> mods-count: "";
    in-out property <bool> mods-empty: false;
    in-out property <bool> mods-loading: false;

    // --- Notifications panel (Discord) ---
    in-out property <bool> notif-enabled: false;
    in-out property <string> notif-mode: "edit-in-place";
    in-out property <string> notif-interval: "600";
    in-out property <string> notif-first-push: "10";
    in-out property <string> notif-log-lines: "15";
    in-out property <string> notif-max-log-chars: "1500";
    in-out property <bool> notif-state-change-posts: true;
    in-out property <string> notif-state-change-debounce: "30";
    in-out property <string> notif-redact: "";
    in-out property <bool> notif-webhook-set: false;
    in-out property <string> notif-webhook: "";
    in-out property <string> notif-result: "";
    in-out property <bool> notif-result-ok: false;
    in-out property <bool> notif-saving: false;
    in-out property <bool> notif-sending: false;
    in-out property <bool> notif-loaded: false;
    in-out property <string> notif-load-error: "";
    in-out property <string> notif-error: "";
    in-out property <bool> notif-dirty: false;
    in-out property <string> notif-status: "";

    // --- confirm dialog (remove / discard) ---
    in-out property <bool> confirm-open: false;
    in-out property <string> confirm-title: "";
    in-out property <string> confirm-text: "";
    in-out property <string> confirm-action: "";
    in-out property <string> confirm-id: "";
    in-out property <string> confirm-node: "";

    callback step(int);
    callback control(string);
    callback send-command(string);
    callback copy-selection(int, int);
    callback add-instance();
    callback add-node();
    callback pick-node(string);
    callback pick-inst(string);
    callback remove-instance(string);
    callback settings-touched();
    callback settings-save();
    callback settings-revert();
    callback settings-scan-workdir();
    callback properties-touched();
    callback properties-save();
    callback properties-revert();
    callback mods-touched();
    callback mods-toggle(string, bool);
    callback notif-touched();
    callback notif-save();
    callback notif-revert();
    callback notif-test();
    callback navigate-tab(int);
    callback confirm-yes();
    callback confirm-no();

    pure function level-color(level: int) -> color {
        return level == 1 ? Theme.warn : level == 2 ? Theme.err : level == 3 ? Theme.debug : Theme.fg;
    }
    pure function state-color(code: int) -> color {
        return code == 0 ? Theme.online
            : code == 1 || code == 2 ? Theme.warn
            : code == 4 || code == 5 ? Theme.crashed
            : Theme.offline;
    }
    pure function can-start(code: int) -> bool {
        return code == 3 || code == 4 || code == 6;
    }
    pure function can-stop(code: int) -> bool {
        return code == 0 || code == 1 || code == 2 || code == 5;
    }
    pure function row-at(y: length) -> int {
        return root.lines.length == 0 ? -1
            : clamp(floor((y - lv.content-y) / Theme.hairline / 22), 0, root.lines.length - 1);
    }

    fs := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "c") {
                if (root.sel-lo >= 0 && root.sel-hi >= 0) {
                    root.copy-selection(min(root.sel-lo, root.sel-hi), max(root.sel-lo, root.sel-hi));
                    return accept;
                }
            }
            if (event.text == Key.DownArrow) {
                root.step(1);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.step(-1);
                return accept;
            }
            if (event.text == Key.PageUp) {
                lv.content-y = clamp(lv.content-y + lv.visible-height, min(0px, lv.visible-height - lv.content-height), 0px);
                root.stick = lv.content-y <= lv.visible-height - lv.content-height + Theme.divider;
                return accept;
            }
            if (event.text == Key.PageDown) {
                lv.content-y = clamp(lv.content-y - lv.visible-height, min(0px, lv.visible-height - lv.content-height), 0px);
                root.stick = lv.content-y <= lv.visible-height - lv.content-height + Theme.divider;
                return accept;
            }
            if (event.text == Key.End) {
                root.stick = true;
                return accept;
            }
            if (event.modifiers.control && event.text == "l") {
                cmd-input.focus();
                return accept;
            }
            if (event.text == Key.Escape) {
                fs.focus();
                return accept;
            }
            if (event.modifiers.control && event.text == "a") {
                root.sel-lo = 0;
                root.sel-hi = root.lines.length - 1;
                return accept;
            }
            reject
        }

        VerticalLayout {
            spacing: 0px;
            HorizontalLayout {
                spacing: 0px;
                // ---- sidebar: nodes grouped, instances nested ----
                Rectangle {
                    width: Theme.w-240;
                    background: Theme.card;
                    ScrollView {
                        width: parent.width;
                        height: parent.height;
                        VerticalLayout {
                            padding: Theme.space-10;
                            spacing: Theme.space-6;
                            Text {
                                text: "NODES";
                                color: Theme.muted-fg;
                                font-size: Theme.text-xs;
                                height: Theme.line-h;
                            }
                            for node in root.nodes: Rectangle {
                                VerticalLayout {
                                    spacing: 0px;
                                    // node heading: name + state dot
                                    Rectangle {
                                        height: Theme.h-44;
                                        background: root.selected-node == node.id ? Theme.selection
                                            : (ta.has-hover ? Theme.card-hover : transparent);
                                        HorizontalLayout {
                                            padding-left: Theme.space-8;
                                            padding-right: Theme.space-8;
                                            spacing: Theme.space-8;
                                            Rectangle {
                                                width: Theme.space-8;
                                                height: Theme.space-8;
                                                border-radius: Theme.radius-xs;
                                                background: root.state-color(node.code);
                                            }
                                            Text {
                                                text: node.name;
                                                color: Theme.fg;
                                                font-size: Theme.text-base;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: node.state;
                                                color: Theme.muted-fg;
                                                font-size: Theme.text-xs;
                                                vertical-alignment: center;
                                            }
                                        }
                                        ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            clicked => { root.pick-node(node.id); }
                                        }
                                    }
                                    // instances of this node
                                    for inst in node.instances: InstanceRow {
                                        id: inst.id;
                                        name: inst.name;
                                        state: inst.state;
                                        code: inst.code;
                                        selected: root.selected-id == inst.id;
                                        picked => { root.pick-inst(inst.id); }
                                    }
                                }
                            }
                            Rectangle { vertical-stretch: 1; }
                            TokBtn {
                                label: "+ Add node";
                                clicked => { root.add-node(); }
                            }
                            TokBtn {
                                label: "+ Add instance";
                                clicked => { root.add-instance(); }
                            }
                            Rectangle { height: Theme.hairline; background: Theme.border; }
                            HorizontalLayout {
                                spacing: Theme.space-6;
                                height: Theme.line-h;
                                Rectangle {
                                    width: Theme.space-8;
                                    height: Theme.space-8;
                                    border-radius: Theme.radius-xs;
                                    background: root.daemon-ok ? Theme.online : Theme.crashed;
                                }
                                Text {
                                    text: root.daemon-ok ? "daemon connected" : "daemon offline";
                                    color: Theme.muted-fg;
                                    font-size: Theme.text-sm;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                // ---- main column ----
                Rectangle {
                console-col := VerticalLayout {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    spacing: Theme.space-8;
                    padding-left: Theme.space-8;
                    padding-right: Theme.space-8;
                    padding-top: Theme.space-8;
                    // top bar: selected instance + controls
                    HorizontalLayout {
                        height: Theme.h-40;
                        spacing: Theme.space-8;
                        Rectangle { width: Theme.divider; }
                        VerticalLayout {
                            spacing: 0px;
                            alignment: center;
                            Text {
                                text: root.instance-name == "" ? "No instance selected" : root.instance-name;
                                color: Theme.fg;
                                font-size: Theme.text-xl;
                                overflow: elide;
                            }
                            Text {
                                text: root.instance-name == "" ? "" : root.instance-state;
                                color: root.state-color(root.instance-code);
                                font-size: Theme.text-xs;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TokBtn {
                            label: "Start";
                            active: true;
                            enabled: root.instance-name != "" && root.can-start(root.instance-code);
                            clicked => { root.control("start"); }
                        }
                        TokBtn {
                            label: "Stop";
                            enabled: root.instance-name != "" && root.can-stop(root.instance-code);
                            clicked => { root.control("stop"); }
                        }
                        TokBtn {
                            label: "Remove";
                            danger: true;
                            enabled: root.instance-name != "";
                            clicked => { root.remove-instance(root.selected-id); }
                        }
                    }
                    // tabs: Console / Settings / Properties / Mods / Notifications
                    HorizontalLayout {
                        height: Theme.tabs-h;
                        spacing: 0px;
                        TokBtn {
                            label: "Console";
                            active: root.settings-tab == 0;
                            clicked => { root.navigate-tab(0); }
                        }
                        TokBtn {
                            label: "Settings";
                            active: root.settings-tab == 1;
                            clicked => { root.navigate-tab(1); }
                        }
                        TokBtn {
                            label: "Properties";
                            active: root.settings-tab == 2;
                            clicked => { root.navigate-tab(2); }
                        }
                        TokBtn {
                            label: "Mods";
                            active: root.settings-tab == 3;
                            clicked => { root.navigate-tab(3); }
                        }
                        TokBtn {
                            label: "Notifications";
                            active: root.settings-tab == 4;
                            clicked => { root.navigate-tab(4); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    // ---- console panel: header/body/stdin as direct layout children (chunk-1 style) ----
                    // console header
                            HorizontalLayout {
                                height: Theme.space-24;
                                spacing: Theme.space-8;
                                Rectangle { width: Theme.divider; }
                                Text {
                                    text: "Console";
                                    color: Theme.fg;
                                    font-size: Theme.text-lg;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.ws-live ? "live" : "reconnecting…";
                                    color: root.ws-live ? Theme.accent : Theme.warn;
                                    font-size: Theme.text-sm;
                                    vertical-alignment: center;
                                }
                            }
                            // console body
                            Rectangle {
                                vertical-stretch: 1;
                                background: Theme.bg;
                                border-radius: Theme.space-6;
                                border-width: Theme.hairline;
                                border-color: Theme.border;
                                clip: true;

                                lv := ListView {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    for line[i] in root.lines: Rectangle {
                                        height: Theme.line-h;
                                        width: 100%;
                                        background: (root.sel-hi >= 0 && i >= min(root.sel-lo, root.sel-hi) && i <= max(root.sel-lo, root.sel-hi)) ? Theme.selection : transparent;
                                        HorizontalLayout {
                                            padding-left: Theme.space-8;
                                            padding-right: Theme.space-8;
                                            spacing: Theme.space-8;
                                            Text {
                                                text: line.ts;
                                                color: Theme.muted-fg;
                                                font-size: Theme.text-base;
                                                width: Theme.w-72;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: "[" + line.tag + "]";
                                                color: root.level-color(line.level);
                                                font-size: Theme.text-base;
                                                width: Theme.w-62;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                text: line.msg;
                                                color: root.level-color(line.level);
                                                font-size: Theme.text-base;
                                                overflow: elide;
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                    }
                                    scrolled => {
                                        root.stick = lv.content-y <= lv.visible-height - lv.content-height + Theme.divider;
                                    }
                                }

                                // selection overlay (leaves Theme.vsep for the scrollbar); captures wheel too
                                TouchArea {
                                    x: 0;
                                    y: 0;
                                    width: parent.width - Theme.vsep;
                                    height: parent.height;
                                    scroll-event(e) => {
                                        lv.content-y = clamp(lv.content-y + e.delta-y, min(0px, lv.visible-height - lv.content-height), 0px);
                                        root.stick = lv.content-y <= lv.visible-height - lv.content-height + Theme.divider;
                                        accept
                                    }
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) {
                                            fs.focus();
                                            root.sel-lo = root.row-at(self.mouse-y);
                                            root.sel-hi = root.sel-lo;
                                        }
                                    }
                                    moved => {
                                        if (self.pressed) {
                                            root.sel-hi = root.row-at(self.mouse-y);
                                        }
                                    }
                                }
                                TokBtn {
                                    x: parent.width - self.width - Theme.line-h;
                                    y: parent.height - self.height - Theme.space-10;
                                    label: "Jump to latest";
                                    active: true;
                                    visible: !root.stick;
                                    clicked => { root.stick = true; }
                                }
                            }
                            // command input
                            Rectangle {
                                height: Theme.h-40;
                                background: Theme.card;
                                border-radius: Theme.space-6;
                                HorizontalLayout {
                                    padding: Theme.space-6;
                                    spacing: Theme.space-8;
                                    cmd-input := LineEdit {
                                        text <=> root.cmd-text;
                                        placeholder-text: "server command (stdin)";
                                        font-family: "Noto Sans";
                                        font-size: Theme.text-base;
                                        accepted => {
                                            root.send-command(root.cmd-text);
                                            root.cmd-text = "";
                                        }
                                    }
                                    TokBtn {
                                        label: "Send";
                                        width: Theme.w-72;
                                        enabled: root.cmd-text != "" && root.instance-name != "";
                                        clicked => {
                                            root.send-command(root.cmd-text);
                                            root.cmd-text = "";
                                        }
                                    }
                                }
                            }
                        }
                    // ---- settings overlay ----
                    // Starts BELOW the top bar + tab row so those stay
                    // visible and clickable while Settings is open
                    // (Theme.overlay-y = 8 padding + 40 top bar + 8 spacing + 28 tabs
                    // + 8 spacing, mirroring console-col's layout).
                    Rectangle {
                        visible: root.settings-tab == 1;
                        x: 0;
                        y: Theme.overlay-y;
                        width: parent.width;
                        height: parent.height - Theme.overlay-y;
                        background: Theme.bg;
                        ScrollView {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            VerticalLayout {
                                spacing: Theme.space-12;
                                padding: Theme.space-10;

                                HorizontalLayout {
                                    spacing: Theme.space-8;
                                    Text {
                                        text: "Settings";
                                        color: Theme.fg;
                                        font-size: Theme.text-xl;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.settings-dirty ? "Unsaved changes" : "Saved";
                                        color: root.settings-dirty ? Theme.warn : Theme.muted-fg;
                                        font-size: Theme.text-sm;
                                        vertical-alignment: center;
                                    }
                                    Text { visible: root.settings-loading; text: "Loading…"; color: Theme.muted-fg; font-size: Theme.text-sm; vertical-alignment: center; }
                                }

                                // ---- Instance group ----
                                Rectangle {
                                    background: Theme.card;
                                    border-radius: Theme.space-6;
                                    border-width: Theme.hairline;
                                    border-color: Theme.border;
                                    VerticalLayout {
                                        spacing: Theme.space-8;
                                        padding: Theme.space-10;
                                        Text { text: "Instance"; color: Theme.muted-fg; font-size: Theme.text-sm; }

                                        Text { text: "Display name"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        LineEdit {
                                            text <=> root.settings-name;
                                            font-size: Theme.text-base;
                                            edited => { root.settings-touched(); }
                                            accepted => { root.settings-save(); }
                                        }

                                        Text { text: "Work dir"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        HorizontalLayout { spacing: Theme.space-8;
                                            LineEdit {
                                                text <=> root.settings-work-dir;
                                                placeholder-text: "/srv/minecraft/survival";
                                                font-family: "Noto Sans Mono";
                                                font-size: Theme.text-base;
                                                horizontal-stretch: 1;
                                                edited => { root.settings-touched(); }
                                                accepted => { root.settings-save(); }
                                            }
                                            Btn2 {
                                                label: "Validate";
                                                enabled: root.settings-work-dir != "";
                                                clicked => { root.settings-scan-workdir(); }
                                            }
                                        }
                                        Text { visible: root.settings-scan-note != ""; text: root.settings-scan-note; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        ErrorText { visible: root.settings-scan-error != ""; content: root.settings-scan-error; }

                                        Text { text: "Java runtime"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        ComboBox {
                                            model: root.settings-java-items;
                                            current-value <=> root.settings-java;
                                            selected => { root.settings-touched(); }
                                            horizontal-stretch: 1;
                                        }
                                        HorizontalLayout { visible: root.settings-java == "Custom path…";
                                            Text { text: "Custom java path"; color: Theme.muted-fg; font-size: Theme.text-sm; width: Theme.w-120; }
                                            LineEdit {
                                                text <=> root.settings-java-custom;
                                                placeholder-text: "/path/to/bin/java";
                                                font-family: "Noto Sans Mono";
                                                font-size: Theme.text-base;
                                                horizontal-stretch: 1;
                                                edited => {
                                                    root.settings-java = root.settings-java-custom;
                                                    root.settings-touched();
                                                }
                                                accepted => { root.settings-save(); }
                                            }
                                        }

                                        HorizontalLayout { spacing: Theme.space-8;
                                            Text { text: "Min RAM (MiB)"; color: Theme.muted-fg; font-size: Theme.text-sm; width: Theme.w-120; }
                                            LineEdit {
                                                text <=> root.settings-min-ram;
                                                placeholder-text: "256";
                                                font-size: Theme.text-base;
                                                width: Theme.w-120;
                                                edited => { root.settings-touched(); }
                                                accepted => { root.settings-save(); }
                                            }
                                        }
                                        HorizontalLayout { spacing: Theme.space-8;
                                            Text { text: "Max RAM (MiB)"; color: Theme.muted-fg; font-size: Theme.text-sm; width: Theme.w-120; }
                                            LineEdit {
                                                text <=> root.settings-max-ram;
                                                placeholder-text: "512";
                                                font-size: Theme.text-base;
                                                width: Theme.w-120;
                                                edited => { root.settings-touched(); }
                                                accepted => { root.settings-save(); }
                                            }
                                        }
                                        HorizontalLayout { spacing: Theme.space-8;
                                            Text { text: "Preset"; color: Theme.muted-fg; font-size: Theme.text-sm; width: Theme.w-120; }
                                            ComboBox {
                                                model: ["none", "aikar", "custom"];
                                                current-value <=> root.settings-preset;
                                                selected => { root.settings-touched(); }
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        Text { visible: root.settings-preset == "custom"; text: "Extra JVM args (one per line)"; color: Theme.muted-fg; font-size: Theme.text-sm; width: Theme.w-220; }
                                        TextEdit { visible: root.settings-preset == "custom";
                                            text <=> root.settings-jvm-extra;
                                            font-family: "Noto Sans Mono";
                                            font-size: Theme.text-base;
                                            height: Theme.h-90;
                                            edited => { root.settings-touched(); }
                                        }
                                        Text {
                                            text: "Final: -Xms" + root.settings-min-ram + " -Xmx"
                                                + root.settings-max-ram
                                                + (root.settings-preset == "aikar" ? " (Aikar's flags)" : "");
                                            color: Theme.muted-fg;
                                            font-size: Theme.text-sm;
                                        }
                                        HorizontalLayout { spacing: Theme.space-8;
                                            Text { text: "Launch mode"; color: Theme.muted-fg; font-size: Theme.text-sm; width: Theme.w-120; }
                                            ComboBox {
                                                model: ["jar", "args-file", "custom"];
                                                current-value <=> root.settings-launch-mode;
                                                selected => { root.settings-touched(); }
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        Text { text: "Launch args"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        LineEdit {
                                            text <=> root.settings-launch-args;
                                            placeholder-text: "-jar server.jar nogui";
                                            font-family: "Noto Sans Mono";
                                            font-size: Theme.text-base;
                                            edited => { root.settings-touched(); }
                                            accepted => { root.settings-save(); }
                                        }
                                        CheckBox {
                                            checked <=> root.settings-autostart;
                                            text: "Auto-start";
                                            toggled => { root.settings-touched(); }
                                        }
                                    }
                                }

                                // ---- Probe group ----
                                Rectangle {
                                    background: Theme.card;
                                    border-radius: Theme.space-6;
                                    border-width: Theme.hairline;
                                    border-color: Theme.border;
                                    VerticalLayout {
                                        spacing: Theme.space-8;
                                        padding: Theme.space-10;
                                        Text { text: "Probe"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        Text { text: "Host"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        LineEdit {
                                            text <=> root.settings-probe-host;
                                            placeholder-text: "127.0.0.1";
                                            font-family: "Noto Sans Mono";
                                            font-size: Theme.text-base;
                                            edited => { root.settings-touched(); }
                                            accepted => { root.settings-save(); }
                                        }
                                        Text { text: "Port"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        LineEdit {
                                            text <=> root.settings-probe-port;
                                            placeholder-text: "25565";
                                            font-size: Theme.text-base;
                                            width: Theme.w-120;
                                            edited => { root.settings-touched(); }
                                            accepted => { root.settings-save(); }
                                        }
                                        Text { text: "Timeout (s)"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        LineEdit {
                                            text <=> root.settings-probe-timeout;
                                            placeholder-text: "3";
                                            font-size: Theme.text-base;
                                            width: Theme.w-120;
                                            edited => { root.settings-touched(); }
                                            accepted => { root.settings-save(); }
                                        }
                                        CheckBox {
                                            checked <=> root.settings-probe-query;
                                            text: "Query enabled";
                                            toggled => { root.settings-touched(); }
                                        }
                                    }
                                }

                                // ---- Restart group ----
                                Rectangle {
                                    background: Theme.card;
                                    border-radius: Theme.space-6;
                                    border-width: Theme.hairline;
                                    border-color: Theme.border;
                                    VerticalLayout {
                                        spacing: Theme.space-8;
                                        padding: Theme.space-10;
                                        Text { text: "Restart"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        Text { text: "Policy"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        ComboBox {
                                            model: ["never", "on-crash"];
                                            current-value <=> root.settings-restart-policy;
                                            selected => { root.settings-touched(); }
                                            horizontal-stretch: 1;
                                        }
                                        Text { text: "Max retries"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        LineEdit {
                                            text <=> root.settings-restart-max-retries;
                                            placeholder-text: "5";
                                            font-size: Theme.text-base;
                                            width: Theme.w-120;
                                            edited => { root.settings-touched(); }
                                            accepted => { root.settings-save(); }
                                        }
                                        Text { text: "Backoff base (s)"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        LineEdit {
                                            text <=> root.settings-restart-backoff-base;
                                            placeholder-text: "5";
                                            font-size: Theme.text-base;
                                            width: Theme.w-120;
                                            edited => { root.settings-touched(); }
                                            accepted => { root.settings-save(); }
                                        }
                                        Text { text: "Backoff max (s)"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        LineEdit {
                                            text <=> root.settings-restart-backoff-max;
                                            placeholder-text: "300";
                                            font-size: Theme.text-base;
                                            width: Theme.w-120;
                                            edited => { root.settings-touched(); }
                                            accepted => { root.settings-save(); }
                                        }
                                        Text { text: "Reset after online (s)"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                        LineEdit {
                                            text <=> root.settings-restart-reset-after;
                                            placeholder-text: "600";
                                            font-size: Theme.text-base;
                                            width: Theme.w-120;
                                            edited => { root.settings-touched(); }
                                            accepted => { root.settings-save(); }
                                        }
                                    }
                                }

                                ErrorText { visible: root.settings-error != ""; content: root.settings-error; }
                                HorizontalLayout { spacing: Theme.space-8;
                                    Btn2 {
                                        label: "Save";
                                        primary: true;
                                        enabled: root.settings-dirty && !root.settings-loading;
                                        clicked => { root.settings-save(); }
                                    }
                                    Btn2 {
                                        label: "Revert";
                                        enabled: root.settings-dirty && !root.settings-loading;
                                        clicked => { root.settings-revert(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.settings-status;
                                        color: Theme.muted-fg;
                                        font-size: Theme.text-sm;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    // ---- properties overlay ----
                    // (sibling of the settings overlay under the main-column
                    // Rectangle — NOT nested inside it, otherwise the whole
                    // subtree hides when settings-tab != 1)
                    Rectangle {
                        visible: root.settings-tab == 2;
                        x: 0;
                        y: Theme.overlay-y;
                        width: parent.width;
                        height: parent.height - Theme.overlay-y;
                        background: Theme.bg;
                        ScrollView {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            VerticalLayout {
                                spacing: Theme.space-12;
                                padding: Theme.space-10;

                                HorizontalLayout {
                                    spacing: Theme.space-8;
                                    Text {
                                        text: "server.properties";
                                        color: Theme.fg;
                                        font-size: Theme.text-xl;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.properties-dirty ? "Unsaved changes" : "Saved.";
                                        color: root.properties-dirty ? Theme.warn : Theme.muted-fg;
                                        font-size: Theme.text-sm;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        visible: root.properties-loading;
                                        text: "Loading…";
                                        color: Theme.muted-fg;
                                        font-size: Theme.text-sm;
                                        vertical-alignment: center;
                                    }
                                }

                                ErrorText {
                                    visible: root.properties-error != "";
                                    content: root.properties-error;
                                }

                                Text {
                                    text: "Raw properties (comments and order preserved)";
                                    color: Theme.muted-fg;
                                    font-size: Theme.text-sm;
                                }

                                Rectangle {
                                    vertical-stretch: 1;
                                    background: Theme.card;
                                    border-radius: Theme.radius-sm;
                                    border-width: Theme.hairline;
                                    border-color: Theme.border;
                                    clip: true;
                                    TextEdit {
                                        x: 0;
                                        y: 0;
                                        width: parent.width;
                                        height: parent.height;
                                        text <=> root.properties-text;
                                        font-family: "Noto Sans Mono";
                                        font-size: Theme.text-base;
                                        edited => { root.properties-touched(); }
                                    }
                                }

                                HorizontalLayout { spacing: Theme.space-8;
                                    Btn2 {
                                        label: "Revert";
                                        enabled: root.properties-dirty && !root.properties-loading;
                                        clicked => { root.properties-revert(); }
                                    }
                                    Btn2 {
                                        label: "Save";
                                        primary: true;
                                        enabled: root.properties-dirty && !root.properties-loading;
                                        clicked => { root.properties-save(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.properties-status;
                                        color: Theme.muted-fg;
                                        font-size: Theme.text-sm;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // ---- mods overlay ----
                    Rectangle {
                        visible: root.settings-tab == 3;
                        x: 0;
                        y: Theme.overlay-y;
                        width: parent.width;
                        height: parent.height - Theme.overlay-y;
                        background: Theme.bg;
                        ScrollView {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            VerticalLayout {
                                spacing: Theme.space-12;
                                padding: Theme.space-10;

                                HorizontalLayout {
                                    spacing: Theme.space-8;
                                    Text {
                                        text: "Mods";
                                        color: Theme.fg;
                                        font-size: Theme.text-xl;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    LineEdit {
                                        text <=> root.mods-filter;
                                        placeholder-text: "Search mods…";
                                        font-size: Theme.text-base;
                                        width: Theme.w-240;
                                        edited => { root.mods-touched(); }
                                    }
                                    Text {
                                        visible: root.mods-loading;
                                        text: "Loading…";
                                        color: Theme.muted-fg;
                                        font-size: Theme.text-sm;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: root.mods-count;
                                    color: Theme.muted-fg;
                                    font-size: Theme.text-sm;
                                }

                                Text {
                                    visible: root.mods-empty && root.mods-filter != "";
                                    text: "No results — try clearing the filter.";
                                    color: Theme.muted-fg;
                                    font-size: Theme.text-sm;
                                }
                                Text {
                                    visible: root.mods-empty && root.mods-filter == "";
                                    text: "No mods found.\nDrop .jar files into <work_dir>/mods/.";
                                    color: Theme.muted-fg;
                                    font-size: Theme.text-sm;
                                }
                                for m in root.mods-filtered: Rectangle {
                                    visible: !root.mods-empty;
                                    height: Theme.h-44;
                                    // NOTE: no full-row TouchArea here — it would sit
                                    // above the HorizontalLayout (z-order) and swallow
                                    // the per-row Disable/Enable TokBtn clicks.
                                    background: transparent;
                                    HorizontalLayout {
                                        padding-left: Theme.space-8;
                                        padding-right: Theme.space-8;
                                        spacing: Theme.space-8;
                                        Text {
                                            text: m.name;
                                            color: Theme.fg;
                                            font-family: "Noto Sans Mono";
                                            font-size: Theme.text-base;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: m.size;
                                            color: Theme.muted-fg;
                                            font-size: Theme.text-sm;
                                            width: Theme.w-72;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: m.enabled ? "enabled" : "disabled";
                                            color: m.enabled ? Theme.accent : Theme.muted-fg;
                                            font-size: Theme.text-sm;
                                            vertical-alignment: center;
                                        }
                                        TokBtn {
                                            label: root.mods-busy == m.name ? "Working…" : (m.enabled ? "Disable" : "Enable");
                                            enabled: root.mods-busy != m.name;
                                            clicked => { root.mods-toggle(m.name, !m.enabled); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ---- notifications overlay ----
                    Rectangle {
                        visible: root.settings-tab == 4;
                        x: 0;
                        y: Theme.overlay-y;
                        width: parent.width;
                        height: parent.height - Theme.overlay-y;
                        background: Theme.bg;
                        ScrollView {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            VerticalLayout {
                                spacing: Theme.space-12;
                                padding: Theme.space-10;

                                HorizontalLayout {
                                    spacing: Theme.space-8;
                                    Text {
                                        text: "Discord";
                                        color: Theme.fg;
                                        font-size: Theme.text-xl;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        visible: root.notif-load-error != "";
                                        text: root.notif-load-error;
                                        color: Theme.err;
                                        font-size: Theme.text-sm;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    visible: !root.notif-loaded && root.notif-load-error == "";
                                    text: "Loading…";
                                    color: Theme.muted-fg;
                                    font-size: Theme.text-sm;
                                }

                                VerticalLayout { visible: root.notif-loaded; spacing: Theme.space-12;
                                        Text { text: "Notifier"; color: Theme.muted-fg; font-size: Theme.text-sm; }

                                        CheckBox {
                                            checked <=> root.notif-enabled;
                                            text: "Enabled";
                                            toggled => { root.notif-touched(); }
                                        }

                                        HorizontalLayout { spacing: Theme.space-8;
                                            Text {
                                                text: "Mode";
                                                width: Theme.w-120;
                                                color: Theme.muted-fg;
                                                font-size: Theme.text-sm;
                                                vertical-alignment: center;
                                            }
                                            ComboBox {
                                                model: ["edit-in-place", "new-message"];
                                                current-value <=> root.notif-mode;
                                                selected => { root.notif-touched(); }
                                                horizontal-stretch: 1;
                                            }
                                        }

                                        HorizontalLayout { spacing: Theme.space-8;
                                            Text {
                                                text: "Interval (seconds)";
                                                width: Theme.w-120;
                                                color: Theme.muted-fg;
                                                font-size: Theme.text-sm;
                                                vertical-alignment: center;
                                            }
                                            LineEdit {
                                                text <=> root.notif-interval;
                                                placeholder-text: "600";
                                                font-size: Theme.text-base;
                                                width: Theme.w-120;
                                                edited => { root.notif-touched(); }
                                            }
                                        }

                                        HorizontalLayout { spacing: Theme.space-8;
                                            Text {
                                                text: "First push delay (s)";
                                                width: Theme.w-120;
                                                color: Theme.muted-fg;
                                                font-size: Theme.text-sm;
                                                vertical-alignment: center;
                                            }
                                            LineEdit {
                                                text <=> root.notif-first-push;
                                                placeholder-text: "10";
                                                font-size: Theme.text-base;
                                                width: Theme.w-120;
                                                edited => { root.notif-touched(); }
                                            }
                                        }

                                        HorizontalLayout { spacing: Theme.space-8;
                                            Text {
                                                text: "Log lines per message";
                                                width: Theme.w-120;
                                                color: Theme.muted-fg;
                                                font-size: Theme.text-sm;
                                                vertical-alignment: center;
                                            }
                                            LineEdit {
                                                text <=> root.notif-log-lines;
                                                placeholder-text: "15";
                                                font-size: Theme.text-base;
                                                width: Theme.w-120;
                                                edited => { root.notif-touched(); }
                                            }
                                        }

                                        HorizontalLayout { spacing: Theme.space-8;
                                            Text {
                                                text: "Max log chars";
                                                width: Theme.w-120;
                                                color: Theme.muted-fg;
                                                font-size: Theme.text-sm;
                                                vertical-alignment: center;
                                            }
                                            LineEdit {
                                                text <=> root.notif-max-log-chars;
                                                placeholder-text: "1500";
                                                font-size: Theme.text-base;
                                                width: Theme.w-120;
                                                edited => { root.notif-touched(); }
                                            }
                                        }

                                        HorizontalLayout { spacing: Theme.space-8;
                                            CheckBox {
                                                checked <=> root.notif-state-change-posts;
                                                text: "State-change posts";
                                                toggled => { root.notif-touched(); }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }

                                        HorizontalLayout { spacing: Theme.space-8;
                                            Text {
                                                text: "State-change debounce (s)";
                                                width: Theme.w-120;
                                                color: Theme.muted-fg;
                                                font-size: Theme.text-sm;
                                                vertical-alignment: center;
                                            }
                                            LineEdit {
                                                text <=> root.notif-state-change-debounce;
                                                placeholder-text: "30";
                                                font-size: Theme.text-base;
                                                width: Theme.w-120;
                                                edited => { root.notif-touched(); }
                                            }
                                        }

                                        Text {
                                            text: "Redact regexes (one per line)";
                                            color: Theme.muted-fg;
                                            font-size: Theme.text-sm;
                                        }
                                        TextEdit {
                                            text <=> root.notif-redact;
                                            font-family: "Noto Sans Mono";
                                            font-size: Theme.text-base;
                                            height: Theme.h-90;
                                            edited => { root.notif-touched(); }
                                        }

                                        Rectangle {
                                            background: Theme.card;
                                            border-radius: Theme.radius-sm;
                                            border-width: Theme.hairline;
                                            border-color: Theme.border;
                                            VerticalLayout {
                                                spacing: Theme.space-8;
                                                padding: Theme.space-10;
                                                Text { text: "Webhook"; color: Theme.muted-fg; font-size: Theme.text-sm; }
                                                Text {
                                                    text: root.notif-webhook-set ? "A webhook URL is stored." : "No webhook stored.";
                                                    color: Theme.muted-fg;
                                                    font-size: Theme.text-sm;
                                                }
                                                LineEdit {
                                                    text <=> root.notif-webhook;
                                                    placeholder-text: "https://discord.com/api/webhooks/…";
                                                    font-family: "Noto Sans Mono";
                                                    font-size: Theme.text-base;
                                                    edited => { root.notif-touched(); }
                                                }
                                                Text {
                                                    text: "The URL is never shown again, never logged, and never sent to the webview.";
                                                    color: Theme.muted-fg;
                                                    font-size: Theme.text-sm;
                                                }
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout { spacing: Theme.space-8;
                                    Btn2 {
                                        label: "Save";
                                        primary: true;
                                        enabled: root.notif-dirty && !root.notif-saving && root.notif-loaded;
                                        clicked => { root.notif-save(); }
                                    }
                                    Btn2 {
                                        label: "Revert";
                                        enabled: root.notif-dirty && !root.notif-saving && root.notif-loaded;
                                        clicked => { root.notif-revert(); }
                                    }
                                    TokBtn {
                                        label: root.notif-sending ? "Sending…" : "Send test";
                                        enabled: !root.notif-sending && root.notif-loaded;
                                        clicked => { root.notif-test(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: root.notif-result;
                                        color: root.notif-result-ok ? Theme.accent : Theme.err;
                                        font-size: Theme.text-sm;
                                        vertical-alignment: center;
                                    }
                                }

                                ErrorText {
                                    visible: root.notif-error != "";
                                    content: root.notif-error;
                                }

                                Text {
                                    text: root.notif-status;
                                    color: Theme.muted-fg;
                                    font-size: Theme.text-sm;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            // ---- status bar ----
            Rectangle {
                height: Theme.h-26;
                background: Theme.card;
                    HorizontalLayout {
                        padding-left: Theme.space-10;
                        padding-right: Theme.space-18;
                        spacing: Theme.space-12;
                        Rectangle {
                            width: Theme.space-8; height: Theme.space-8; border-radius: Theme.radius-xs;
                            background: root.daemon-ok ? Theme.online : Theme.crashed;
                        }
                        Text {
                            text: root.daemon-info;
                            color: Theme.muted-fg;
                            font-size: Theme.text-sm;
                            vertical-alignment: center;
                        }
                        Rectangle { width: Theme.hairline; height: Theme.vsep; background: Theme.border; }
                        Text {
                            text: root.ws-live ? "console: connected" : "console: reconnecting";
                            color: root.ws-live ? Theme.muted-fg : Theme.warn;
                            font-size: Theme.text-sm;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.status;
                            color: Theme.muted-fg;
                            font-size: Theme.text-sm;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: "ring " + root.lines.length + "/1000";
                            color: Theme.muted-fg;
                            font-size: Theme.text-sm;
                            vertical-alignment: center;
                        }
                    }
            }
        }
    }

    // ---- confirm dialog (modal overlay) ----
    Rectangle {
        visible: root.confirm-open;
        width: parent.width;
        height: parent.height;
        background: Theme.backdrop;
        TouchArea { clicked => {} }
        Rectangle {
            x: parent.width / 2 - Theme.w-210;
            y: parent.height / 2 - Theme.h-100;
            width: Theme.w-420;
            height: Theme.h-200;
            background: Theme.card;
            border-radius: Theme.space-8;
            border-width: Theme.hairline;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.space-18;
                spacing: Theme.space-12;
                alignment: center;
                Text {
                    text: root.confirm-title;
                    color: Theme.fg;
                    font-size: Theme.text-lg;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.confirm-text;
                    color: Theme.muted-fg;
                    font-size: Theme.text-sm;
                    horizontal-alignment: center;
                }
                HorizontalLayout { spacing: Theme.space-8; alignment: center;
                    TokBtn {
                        label: "No";
                        clicked => { root.confirm-no(); }
                    }
                    TokBtn {
                        label: "Yes";
                        danger: root.confirm-action == "remove";
                        clicked => { root.confirm-yes(); }
                    }
                }
            }
        }
    }

    Timer {
        interval: 50ms;
        running: true;
        triggered => {
            if (root.stick && lv.content-height > lv.visible-height) {
                lv.content-y = lv.visible-height - lv.content-height;
            }
        }
    }
    // `init` runs before the Wayland surface is mapped; without this
    // deferred focus the window receives keys but no element owns focus,
    // so Ctrl+C/Ctrl+L would be dead until the first mouse click.
    focus-timer := Timer {
        interval: 300ms;
        running: true;
        triggered => {
            fs.focus();
            self.running = false;
        }
    }
    init => {
        fs.focus();
    }
}

// Add-instance wizard dialog (P1 chunk 2). Four steps: identity → Java →
// RAM/preset → launch mode/args/review. Owns its fields as properties so
// the Rust side can reset them on open and read them on submit.
component BtnWiz inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked;
    height: Theme.h-32;
    width: max(Theme.w-88, txt.preferred-width + Theme.space-24);
    border-radius: Theme.space-6;
    border-width: Theme.hairline;
    border-color: !root.enabled ? Theme.border : (root.primary ? Theme.accent : Theme.border);
    background: (!root.enabled || root.primary) ? Theme.card-hover : Theme.card;
    ta := TouchArea {
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
    txt := Text {
        text: root.label;
        color: !root.enabled ? Theme.muted-fg : (root.primary ? Theme.accent-text : Theme.fg);
        font-size: Theme.text-base;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component ErrorTextWiz inherits Text {
    in property <string> content: "";
    text: root.content;
    color: Theme.err;
    font-size: Theme.text-sm;
    overflow: elide;
}

export component WizardWindow inherits Window {
    title: "Add instance — Minewrap";
    min-width: Theme.wiz-min-w;
    min-height: Theme.wiz-min-h;
    background: Theme.bg;
    default-font-family: "Noto Sans";
    default-font-size: Theme.text-base;

    in-out property <string> wiz-id: "";
    in-out property <string> wiz-name: "";
    in-out property <string> wiz-work-dir: "";
    in-out property <string> wiz-java: "java";
    in-out property <string> wiz-min-ram: "256";
    in-out property <string> wiz-max-ram: "512";
    in-out property <string> wiz-preset: "none";
    in-out property <string> wiz-launch-mode: "jar";
    in-out property <string> wiz-launch-args: "";
    in-out property <bool> wiz-autostart: false;
    in-out property <[string]> wiz-java-items: ["java"];
    in-out property <string> wiz-java-custom: "";
    in-out property <string> wiz-error: "";
    in-out property <string> wiz-scan-note: "";
    in-out property <int> wiz-step: 1;
    in-out property <bool> wiz-busy: false;

    callback cancel;
    callback submit;
    callback scan-workdir;
    callback detect-java;

    property <color> muted-fg: Theme.muted-fg;
    property <color> err: Theme.err;

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: Theme.space-16;
            spacing: Theme.space-12;

            Text {
                text: "Add instance";
                font-size: Theme.text-wizard;
                color: Theme.fg;
            }
            Text {
                text: "step " + root.wiz-step + "/4";
                color: root.muted-fg;
                font-size: Theme.text-sm;
            }

                        // ---- step 1: identity ----
            VerticalLayout { visible: root.wiz-step == 1; spacing: Theme.space-8;
                Text { text: "ID"; color: root.muted-fg; font-size: Theme.text-sm; }
                LineEdit {
                    text <=> root.wiz-id;
                    placeholder-text: "survival";
                    font-family: "Noto Sans Mono";
                    font-size: Theme.text-base;
                    accepted => { root.submit(); }
                }
                Text { text: "Display name (optional)"; color: root.muted-fg; font-size: Theme.text-sm; }
                LineEdit {
                    text <=> root.wiz-name;
                    placeholder-text: "Survival";
                    font-size: Theme.text-base;
                    accepted => { root.submit(); }
                }
                Text { text: "Work dir"; color: root.muted-fg; font-size: Theme.text-sm; }
                HorizontalLayout { spacing: Theme.space-8;
                    LineEdit {
                        text <=> root.wiz-work-dir;
                        placeholder-text: "/srv/minecraft/survival";
                        font-family: "Noto Sans Mono";
                        font-size: Theme.text-base;
                        horizontal-stretch: 1;
                        accepted => { root.submit(); }
                    }
                    BtnWiz {
                        label: "Scan";
                        enabled: root.wiz-work-dir != "" && !root.wiz-busy;
                        clicked => { root.scan-workdir(); }
                    }
                }
                Text { visible: root.wiz-scan-note != ""; text: root.wiz-scan-note; color: root.muted-fg; font-size: Theme.text-sm; }
                ErrorTextWiz { visible: root.wiz-error != ""; content: root.wiz-error; }
            }

            // ---- step 2: Java ----
            VerticalLayout { visible: root.wiz-step == 2; spacing: Theme.space-8;
                Text { text: "Java runtime"; color: root.muted-fg; font-size: Theme.text-sm; }
                ComboBox {
                    model: root.wiz-java-items;
                    current-value <=> root.wiz-java;
                    horizontal-stretch: 1;
                }
                BtnWiz {
                    label: "Rescan";
                    enabled: !root.wiz-busy;
                    clicked => { root.detect-java(); }
                }
                HorizontalLayout { visible: root.wiz-java == "Custom path…";
                    LineEdit {
                        text <=> root.wiz-java-custom;
                        placeholder-text: "/path/to/bin/java";
                        font-family: "Noto Sans Mono";
                        font-size: Theme.text-base;
                        horizontal-stretch: 1;
                        edited => { root.wiz-java = root.wiz-java-custom; }
                        accepted => { root.submit(); }
                    }
                }
                ErrorTextWiz { visible: root.wiz-error != ""; content: root.wiz-error; }
            }

            // ---- step 3: RAM + preset ----
            VerticalLayout { visible: root.wiz-step == 3; spacing: Theme.space-8;
                HorizontalLayout { spacing: Theme.space-8;
                    Text { text: "Min RAM (MiB)"; color: root.muted-fg; font-size: Theme.text-sm; width: Theme.w-120; }
                    LineEdit {
                        text <=> root.wiz-min-ram;
                        placeholder-text: "256";
                        font-size: Theme.text-base;
                        width: Theme.w-120;
                        accepted => { root.submit(); }
                    }
                }
                HorizontalLayout { spacing: Theme.space-8;
                    Text { text: "Max RAM (MiB)"; color: root.muted-fg; font-size: Theme.text-sm; width: Theme.w-120; }
                    LineEdit {
                        text <=> root.wiz-max-ram;
                        placeholder-text: "512";
                        font-size: Theme.text-base;
                        width: Theme.w-120;
                        accepted => { root.submit(); }
                    }
                }
                HorizontalLayout { spacing: Theme.space-8;
                    Text { text: "Preset"; color: root.muted-fg; font-size: Theme.text-sm; width: Theme.w-120; }
                    ComboBox {
                        model: ["none", "aikar", "custom"];
                        current-value <=> root.wiz-preset;
                        horizontal-stretch: 1;
                    }
                }
                ErrorTextWiz { visible: root.wiz-error != ""; content: root.wiz-error; }
            }

            // ---- step 4: launch mode / args / review ----
            VerticalLayout { visible: root.wiz-step == 4; spacing: Theme.space-8;
                HorizontalLayout { spacing: Theme.space-8;
                    Text { text: "Launch mode"; color: root.muted-fg; font-size: Theme.text-sm; width: Theme.w-120; }
                    ComboBox {
                        model: ["jar", "args-file", "custom"];
                        current-value <=> root.wiz-launch-mode;
                        horizontal-stretch: 1;
                    }
                }
                Text { text: "Launch args"; color: root.muted-fg; font-size: Theme.text-sm; }
                LineEdit {
                    text <=> root.wiz-launch-args;
                    placeholder-text: "-jar server.jar nogui";
                    font-family: "Noto Sans Mono";
                    font-size: Theme.text-base;
                    accepted => { root.submit(); }
                }
                CheckBox {
                    checked <=> root.wiz-autostart;
                    text: "Auto-start";
                }
                Text {
                    text: "Final: -Xms" + root.wiz-min-ram + " -Xmx" + root.wiz-max-ram
                        + (root.wiz-preset == "aikar" ? " (Aikar's flags)" : "");
                    color: root.muted-fg;
                    font-size: Theme.text-sm;
                }
                ErrorTextWiz { visible: root.wiz-error != ""; content: root.wiz-error; }
            }

// ---- actions ----
            HorizontalLayout { spacing: Theme.space-8;
                BtnWiz {
                    label: "Back";
                    primary: false;
                    enabled: root.wiz-step > 1 && !root.wiz-busy;
                    clicked => { root.wiz-step = root.wiz-step - 1; }
                }
                Rectangle { horizontal-stretch: 1; }
                BtnWiz {
                    label: "Cancel";
                    primary: false;
                    clicked => { root.cancel(); }
                }
                BtnWiz {
                    label: (root.wiz-step == 4 ? "Add instance" : "Next");
                    primary: true;
                    enabled: !root.wiz-busy;
                    clicked => {
                        if (root.wiz-step == 4) {
                            root.submit();
                        } else {
                            root.wiz-step = root.wiz-step + 1;
                        }
                    }
                }
            }
        }
    }
}

/// Nodes panel: registry table (name, url, state, retry/remove) plus the
/// Add remote node form. Lazy-created and shown from the sidebar
/// ("+ Add node") — like the wizard, a window must not be created before
/// `run()` on the winit-wayland + software-renderer path.
export component NodesWindow inherits Window {
    title: "Nodes — Minewrap";
    width: 740px;
    height: 560px;
    background: Theme.bg;
    default-font-family: "Noto Sans";
    default-font-size: Theme.text-base;

    in-out property <[NodeRow]> nodes: [];
    in-out property <string> new-name: "";
    in-out property <string> new-url: "";
    in-out property <string> new-token: "";
    in-out property <string> nodes-error: "";

    callback add-node(string, string, string);
    callback remove-node(string);
    callback retry-node(string);

    pure function dot-color(code: int) -> color {
        return code == 0 ? Theme.online
            : code == 1 || code == 2 ? Theme.warn
            : code == 4 || code == 5 ? Theme.crashed
            : Theme.offline;
    }

    VerticalLayout {
        padding: Theme.space-16;
        spacing: Theme.space-12;

        HorizontalLayout {
            spacing: Theme.space-8;
            Text {
                text: "Nodes";
                color: Theme.fg;
                font-size: Theme.text-xl;
            }
            Rectangle { horizontal-stretch: 1; }
            Btn2 {
                label: "Close";
                clicked => { root.hide(); }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout { spacing: Theme.space-6;
                for node in root.nodes: Rectangle {
                    height: Theme.h-44;
                    background: (ta.has-hover ? Theme.card-hover : transparent);
                    border-radius: Theme.space-6;
                    HorizontalLayout {
                        padding-left: Theme.space-8;
                        padding-right: Theme.space-8;
                        spacing: Theme.space-8;
                        Rectangle {
                            width: Theme.space-8;
                            height: Theme.space-8;
                            border-radius: Theme.radius-xs;
                            background: root.dot-color(node.code);
                        }
                        Text {
                            text: node.name;
                            color: Theme.fg;
                            font-size: Theme.text-base;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: node.url;
                            color: Theme.muted-fg;
                            font-family: "Noto Sans Mono";
                            font-size: Theme.text-xs;
                            width: Theme.w-240;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Text {
                            text: node.state;
                            color: Theme.muted-fg;
                            font-size: Theme.text-xs;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TokBtn {
                            label: "Retry";
                            enabled: node.code != 0;
                            clicked => { root.retry-node(node.id); }
                        }
                        TokBtn {
                            label: "Remove";
                            danger: true;
                            enabled: !node.is_local;
                            clicked => { root.remove-node(node.id); }
                        }
                    }
                    ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => {}
                    }
                }
            }
        }

        Rectangle {
            background: Theme.card;
            border-radius: Theme.space-6;
            border-width: Theme.hairline;
            border-color: Theme.border;
            VerticalLayout {
                spacing: Theme.space-8;
                padding: Theme.space-10;

                Text {
                    text: "Add remote node";
                    color: Theme.muted-fg;
                    font-size: Theme.text-sm;
                }

                HorizontalLayout { spacing: Theme.space-8;
                    Text {
                        text: "Name";
                        color: Theme.muted-fg;
                        font-size: Theme.text-sm;
                        width: Theme.w-120;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text <=> root.new-name;
                        placeholder-text: "Home server";
                        horizontal-stretch: 1;
                        font-size: Theme.text-base;
                        edited => { root.nodes-error = ""; }
                    }
                }

                HorizontalLayout { spacing: Theme.space-8;
                    Text {
                        text: "URL";
                        color: Theme.muted-fg;
                        font-size: Theme.text-sm;
                        width: Theme.w-120;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text <=> root.new-url;
                        placeholder-text: "http://127.0.0.1:8391";
                        font-family: "Noto Sans Mono";
                        horizontal-stretch: 1;
                        font-size: Theme.text-base;
                        edited => { root.nodes-error = ""; }
                    }
                }

                HorizontalLayout { spacing: Theme.space-8;
                    Text {
                        text: "Token";
                        color: Theme.muted-fg;
                        font-size: Theme.text-sm;
                        width: Theme.w-120;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text <=> root.new-token;
                        placeholder-text: "Bearer token from the remote minewrapd";
                        font-family: "Noto Sans Mono";
                        horizontal-stretch: 1;
                        font-size: Theme.text-base;
                        edited => { root.nodes-error = ""; }
                    }
                }

                Text {
                    visible: root.nodes-error != "";
                    text: root.nodes-error;
                    color: Theme.err;
                    font-size: Theme.text-sm;
                }

                HorizontalLayout { spacing: Theme.space-8;
                    Btn2 {
                        label: "Add node";
                        primary: true;
                        enabled: root.new-url != "";
                        clicked => {
                            root.add-node(root.new-name, root.new-url, root.new-token);
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                Text {
                    text: "The token is stored in nodes.json (mode 0600) and is never shown again.";
                    color: Theme.muted-fg;
                    font-size: Theme.text-xs;
                }
            }
        }
    }

}
