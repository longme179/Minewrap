#!/bin/sh
# AppImage entry point.
#
#   mcpanel-gui-x86_64.AppImage                        -> GUI
#   mcpanel-gui-x86_64.AppImage --daemon --config ...  -> bundled daemon
#   mcpanel-gui-x86_64.AppImage --daemon --help        -> daemon usage
HERE="$(dirname "$(readlink -f "$0")")"

if [ "${1:-}" = "--daemon" ]; then
  shift
  exec "$HERE/usr/bin/mcpanel-daemon" "$@"
fi
exec "$HERE/usr/lib/mcpanel-gui/mcpanel-gui" "$@"
