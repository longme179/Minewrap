# mcpanel daemon (systemd user unit example)
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp packaging/mcpanel-daemon.service ~/.config/systemd/user/
#   # edit WorkingDirectory/ExecStart/config paths below
#   systemctl --user daemon-reload
#   systemctl --user enable --now mcpanel-daemon
#   journalctl --user -u mcpanel-daemon -f
#
# The daemon stops its Minecraft children itself on SIGTERM (uvicorn triggers
# the app lifespan shutdown), so TimeoutStopSec must cover the slowest stop
# escalation (stop_timeout + a few seconds).

[Unit]
Description=mcpanel node daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mcpanel
ExecStart=%h/.local/bin/mcpanel-daemon --config %h/mcpanel/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=90

[Install]
WantedBy=default.target
